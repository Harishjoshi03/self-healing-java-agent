SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healing_agent
SPRING_DATASOURCE_USERNAME=healing_agent
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

# Local API basic-auth account. Replace before exposing the service.
AGENT_API_USERNAME=agent
AGENT_API_PASSWORD=change-me-local-only

# Keep offline mode until an approved provider key is configured.
AGENT_AI_MODE=offline
AI_PROVIDER_API_KEY=

# Required for repository investigation. Use one clean, disposable checkout.
AGENT_ENABLED=false
AGENT_REPOSITORY_ID=owner/repository
AGENT_REPOSITORY_ROOT=/absolute/path/to/clean/checkout
AGENT_ALLOWED_BRANCHES=main
AGENT_KILL_SWITCH=false

# Patch and PR integrations remain disabled until independently reviewed.
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=300
AUTO_CREATE_PR=false
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

MAX_PATCH_ATTEMPTS=2
AUTO_DEPLOY_ENABLED=false

# Optional phased integration placeholders.
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=