# Local development placeholders only. Never commit real credentials.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healing_agent
SPRING_DATASOURCE_USERNAME=healing_agent
SPRING_DATASOURCE_PASSWORD=replace_me

# Configure the provider supported by the chosen Spring AI starter.
AI_PROVIDER_API_KEY=replace_me

# Optional GitHub integration; use a least-privilege GitHub App/token.
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# Optional Jira integration.
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=

MAX_PATCH_ATTEMPTS=2
SANDBOX_TIMEOUT_SECONDS=300
AUTO_CREATE_PR=false
AUTO_DEPLOY_ENABLED=false
